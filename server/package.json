{
  "name": "orderpilot-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "migrate": "node --env-file-if-exists=../.env src/scripts/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/scripts/seed.js",
    "db:local": "node --env-file-if-exists=../.env src/scripts/localdb.js",
    "test": "DATABASE_URL=postgres://postgres:postgres@localhost:54329/orderpilot SUPABASE_URL= SUPABASE_SERVICE_ROLE_KEY= GEMINI_MOCK=1 node --env-file-if-exists=../.env --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
