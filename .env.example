# Copy to .env and fill in. Never commit .env. These values stay on the server only.

# --- Database -------------------------------------------------------------
# Hosted Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development (run `npm run db:local` in its own terminal):
DATABASE_URL=postgres://postgres:postgres@localhost:54329/orderpilot

# --- Auth -----------------------------------------------------------------
# Long random string (at least 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=

# --- Supabase Storage (private bucket for order photos / voice notes) ------
# Project Settings -> API. Leave empty to store files in server/.storage locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=order-files

# --- Gemini ---------------------------------------------------------------
# Leave empty to run in mock mode (typed text only). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Lighter model used when the main one is busy (leave empty to disable)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Seed data (test logins for the demo; change for anything real) -------
SEED_PASSWORD=orderpilot-demo

PORT=4000
CORS_ORIGIN=http://localhost:5173
